{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "article-lab-review",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "article-lab-review",
      "database_id": "165e621b-2338-46e1-8dd2-9663d54d207b",
      "migrations_dir": "migrations",
    },
  ],
  // Image storage is staged but not deployed yet: the scoped deployment token
  // has no R2 permission (auth error 10000), so the private bucket cannot be
  // created or confirmed. Create `article-lab-images` (or grant the token R2
  // edit on it), then uncomment this binding and redeploy. Until then the
  // image lanes return an honest 503 and the UI reports them unconfigured.
  // "r2_buckets": [
  //   {
  //     "binding": "IMAGES",
  //     "bucket_name": "article-lab-images",
  //   },
  // ],
  "routes": [
    {
      "pattern": "feedback.moneymattersmedia.com",
      "custom_domain": true,
    },
  ],
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://feedback.moneymattersmedia.com",
  },
}
