{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "openTelemetry": true
  },
  "plugin": ["opencode-plugin-langfuse"],
  "skills": {
    "paths": [".opencode/vendor/langfuse-skills/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 10000
    }
  }
}
